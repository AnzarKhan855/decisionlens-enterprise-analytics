# ============================================
# DecisionLens Enterprise Configuration
# ============================================
# Copy this file to backend/.env and fill in your values.
# DO NOT commit backend/.env to version control.

# --------------------------------------------
# Application
# --------------------------------------------
DEBUG=false
LOG_LEVEL=INFO

# --------------------------------------------
# Database
# --------------------------------------------
# SQLAlchemy database URL. Examples:
#   SQLite (dev): sqlite:///./decisionlens.db
#   PostgreSQL (prod): postgresql://user:password@host:5432/decisionlens
DATABASE_URL=sqlite:///./decisionlens.db

# --------------------------------------------
# Security / Authentication
# --------------------------------------------
# REQUIRED: Must be a strong random string (min 32 chars).
# Used to sign and verify JWT access/refresh tokens.
JWT_SECRET=

# REQUIRED: Must be a strong random string (min 32 chars).
# Used for HMAC-SHA256 OTP hashing.
OTP_SECRET=

# REQUIRED: Super admin account email (lowercase).
SUPER_ADMIN_EMAIL=

# REQUIRED: Super admin account password (min 8 chars, use a strong password).
SUPER_ADMIN_PASSWORD=

# Optional: Super admin role. Defaults to SUPER_ADMIN.
SUPER_ADMIN_ROLE=SUPER_ADMIN

# Optional: Password hashing salt. If empty, JWT_SECRET is used as fallback.
PASSWORD_SALT=

# --------------------------------------------
# Email (Resend)
# --------------------------------------------
# REQUIRED for email features (OTP, password reset, notifications).
# Get your API key at https://resend.com
RESEND_API_KEY=

# Sender email address. Must be verified in your Resend account.
EMAIL_FROM=onboarding@resend.dev

# --------------------------------------------
# CORS
# --------------------------------------------
# Comma-separated list of allowed origins for production.
# Example: ALLOWED_ORIGINS=https://app.decisionlens.ai,https://admin.decisionlens.ai
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------
# Optional: Redis (for production caching)
# --------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# Optional: File Upload Limits
# --------------------------------------------
# MAX_UPLOAD_SIZE_MB=500
# MAX_ZIP_SIZE_GB=2

# --------------------------------------------
# Optional: Workers / Performance
# --------------------------------------------
# UVICORN_WORKERS=4
# DUCKDB_THREADS=4
# DUCKDB_MEMORY_LIMIT=2GB
