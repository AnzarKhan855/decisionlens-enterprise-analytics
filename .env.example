APP_NAME=DecisionLens Enterprise Decision Intelligence Platform
ENV=production
DEBUG=false
SECRET_KEY=change-me-in-production-64-char-minimum
JWT_SECRET=change-me-in-production-64-char-minimum
PASSWORD_SALT=change-me-in-production-64-char-minimum
OTP_SECRET=change-me-in-production-64-char-minimum

DATABASE_URL=sqlite:///./decisionlens.db
MONGODB_URL=mongodb://mongo:27017/decisionlens
REDIS_URL=redis://redis:6379/0

SUPER_ADMIN_EMAIL=admin@decisionlens.io
SUPER_ADMIN_PASSWORD=change-me-in-production

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024

RESEND_API_KEY=
EMAIL_FROM=noreply@decisionlens.io

IMPORT_ROOT=./uploads
BROWSE_ROOT=./uploads

MAX_UPLOAD_SIZE_MB=500
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
LOG_DIR=./logs

DASHBOARD_CACHE_TTL=60
ANALYTICS_CACHE_TTL=300
FORECAST_CACHE_TTL=600

WORKERS=4
